{
  "name": "@pleodigital/design-system-transbit",
  "version": "1.0.12",
  "repository": {
    "type": "git",
    "url": "https://github.com/PLEO-group/design-system-transbit"
  },
  "description": "Design tokens for Transbit, generated from Tokens Studio exports.",
  "style": "dist/css/tokens.css",
  "exports": {
    ".": "./dist/css/tokens.css",
    "./css/tokens.css": "./dist/css/tokens.css",
    "./css/typography.css": "./dist/css/typography.css",
    "./css/*": "./dist/css/*",
    "./icons": "./dist/assets/react/icons/index.ts",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "author": "",
  "license": "ISC",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.js",
    "build:tokens": "node build-style-dictionary.js",
    "transform:icons": "npx @svgr/cli assets/icons --out-dir dist/assets/react/icons --jsx-runtime classic --typescript --config-file .svgrrc-icons.json",
    "transform:illustrations": "npx @svgr/cli assets/illustrations --out-dir dist/assets/react/illustrations --jsx-runtime classic --typescript --config-file .svgrrc-illustrations.json",
    "copy:icons": "cpx 'assets/icons/*.svg' dist/assets/angular/svg-raw/icons",
    "build": "npm run build:tokens && npm run transform:icons && npm run transform:illustrations && npm run copy:icons",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.2.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@storybook/theming": "^8.6.18",
    "@svgr/cli": "^8.1.0",
    "cpx": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.0.0",
    "style-dictionary": "^3.9.2"
  }
}
